# Production build (npm run build / Cloudflare). URL of the public backend, without a trailing slash.
# After creating the Hugging Face Space, set it like:
#   VITE_API_URL=https://<hf-user>-spherex-api.hf.space
# Empty = same origin /api, which the Cloudflare static site does not serve: the viewer then
# falls back to the five stored targets in public/snapshots and live IRSA searches fail.
# Note: a local .env.local overrides this file in local builds; Cloudflare builds do not see it.
VITE_API_URL=
